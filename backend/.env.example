# Copy this file to `.env` and fill in real values for your environment.
#
# In production (DJANGO_SETTINGS_MODULE=config.settings.production), these
# are never read from a file — Render injects the real values directly as
# process environment variables, and no .env file exists in that deploy.
#
# In local development (config.settings.local), a `.env` file next to this
# one (i.e. backend/.env) IS read automatically on startup (see
# config/dotenv_loader.py), so most local devs only need ANTHROPIC_API_KEY
# below; DEBUG/SECRET_KEY/DATABASE_URL/etc. are hardcoded for local dev in
# config/settings/local.py and don't need to be set here. An already-exported
# shell variable always wins over the same key in this file.

# Set to "False" in production. Never enable DEBUG in production.
DEBUG=False

# A long, random, unpredictable string. Generate with e.g.:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme

# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://riser:riser@localhost:5432/riser

# Comma-separated list of hostnames this Django instance may serve.
ALLOWED_HOSTS=riser-backend-y19g.onrender.com

# Comma-separated list of allowed frontend origins (scheme + host, no path).
CORS_ALLOWED_ORIGINS=https://riser-frontend.onrender.com

# Anthropic API key for the AI risk-narration briefing (Sprint 02). Get one at
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=changeme
